# Supabase (public values, shipped to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_OR_ANON_KEY=<anon-or-publishable-key>

# Server-only secrets — never prefix these with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
DATABASE_URL=postgresql://postgres:<password>@<host>:6543/postgres

# AI service (knoverse-ai). docker-compose overrides PY_SERVER_URL to http://api:8000.
PY_SERVER_URL=http://localhost:8000
# Must match AI_SERVICE_TOKEN in knoverse-ai/.env. Generate with: openssl rand -hex 32
AI_SERVICE_TOKEN=<shared-secret>

# Optional: max PDF upload size in MB (default 20)
# MAX_UPLOAD_MB=20
